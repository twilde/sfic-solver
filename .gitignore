# Safety net: real system files hold real bittings and must never be committed.
# Ignore every .json, .csv and .txt (system files, exported key matrices, pinning
# charts), then un-ignore only the example and the fake test fixtures.
# scripts/check_no_stray_data.py (pre-commit hook + CI) enforces the same rule.
*.json
!/system.example.json
!/tests/fixtures/**/*.json
*.csv
!/tests/fixtures/**/*.csv
*.txt
!/tests/fixtures/**/*.txt
# Scans and PDFs of charts (real key data too). Ignored everywhere, fixtures
# included, and written case-insensitively because scanners and phones write
# IMG_0001.JPG and SCAN.PDF.
*.[pP][dD][fF]
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[dD][nN][gG]
*.[aA][vV][iI][fF]
*.[jJ][pP]2
*.[gG][iI][fF]
*.[bB][mM][pP]
*.[wW][eE][bB][pP]

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/

# OS / editor
.DS_Store
